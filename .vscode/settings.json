{
    //windows
    // 1. 让 analyzer 以 Windows 为主 target（这样 Windows 代码不灰、winreg 有提示）
    "rust-analyzer.cargo.target": "x86_64-pc-windows-msvc",
    // 2. 强制开启 windows feature → winreg 被加载
    "rust-analyzer.cargo.features": ["windows"],

    //macos
    // "rust-analyzer.cargo.target": "aarch64-apple-darwin",
    // // 2. 强制开启 windows feature → winreg 被加载
    // "rust-analyzer.cargo.features": [],

    //linux
    //  "rust-analyzer.cargo.target": "x86_64-unknown-linux-gnu",
    // // 2. 强制开启 windows feature → winreg 被加载
    // "rust-analyzer.cargo.features": [],

    // 3. 关键：让 cfg(target_os = xxx) 都能被解析，不被忽略
    // "rust-analyzer.cargo.allFeatures": true,
    "rust-analyzer.check.allTargets": false, // 不要同时全检查，会乱
    "rust-analyzer.checkOnSave": true,

    // 4. 补全 & 宏展开
    "rust-analyzer.procMacro.enable": true,
    "rust-analyzer.completion.enable": true
}